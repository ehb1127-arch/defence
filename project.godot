; Engine configuration file.
config_version=5

[application]

config/name="결계 수호대"
config/use_custom_user_dir=true
config/custom_user_dir_name="SquareGuardians"
config/description="결계 수호대: 랜덤 합성 디펜스 - 사각 결계를 도는 괴물을 유닛 합성으로 막는 협동/대전 디펜스"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
ads/android_rewarded_id="ca-app-pub-3940256099942544/5224354917"
ads/ios_rewarded_id="ca-app-pub-3940256099942544/1712485313"
boot_splash/bg_color=Color(0.05, 0.06, 0.13, 1)
legal/terms_url="https://example.com/terms"
legal/privacy_url="https://example.com/privacy"

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
Session="*res://scripts/autoload/Session.gd"
Net="*res://scripts/autoload/Net.gd"
Sfx="*res://scripts/autoload/Sfx.gd"
Music="*res://scripts/autoload/Music.gd"
Art="*res://scripts/autoload/Art.gd"
Profile="*res://scripts/autoload/Profile.gd"
Ads="*res://scripts/autoload/Ads.gd"
Platform="*res://scripts/autoload/Platform.gd"
Store="*res://scripts/autoload/Store.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.13, 1)

[gui]

theme/custom_font="res://fonts/NanumSquareRoundB.ttf"
